FROM --platform=linux/amd64 sweb.eval.x86_64.marshmallow-code__marshmallow-1524:latest

RUN rm -rf /testbed
COPY marshmallow-1810 /testbed
RUN cd /testbed \
    && test "$(git rev-parse HEAD)" = "23d0551569d748460c504af85996451edd685371" \
    && test "$(git rev-list --all --count)" -eq 1 \
    && git remote remove origin \
    && /opt/miniconda3/envs/testbed/bin/python -m pip install --no-deps -e . \
    && git config --global user.email setup@swebench.config \
    && git config --global user.name SWE-bench \
    && git commit --allow-empty -am SWE-bench

WORKDIR /testbed
