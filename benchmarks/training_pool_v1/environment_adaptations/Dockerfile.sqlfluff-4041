RUN rm -rf /testbed
COPY sqlfluff-4041 /testbed
RUN cd /testbed \
    && test "$(git rev-parse HEAD)" = "66fd602d0824138f212082c8fdf381266a9edad3" \
    && git remote remove origin \
    && /opt/miniconda3/envs/testbed/bin/python -m pip install --no-deps -e . \
